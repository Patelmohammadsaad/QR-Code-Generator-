   "source": [
    "import qrcode\n",
    "\n",
    "data = input(\"Enter text or URL to generate QR code\")\n",
    "\n",
    "qr = qrcode.make(data)\n",
    "\n",
    "qr.save(\"QRcode.png\")\n",
    "\n",
    "print(\"QR code generate and saved as 'qrcode.png'\")"
   ]
